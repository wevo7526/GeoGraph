# GeoGraph configuration. EVERY VALUE HERE IS OPTIONAL — a fresh clone runs
# `python -m core.api.app` with no .env at all. Each unset value disables one
# capability and the startup log says which; nothing here is required to read
# whatever graph exists. Values that ARE set are validated by CONTENT, not
# presence (see core/settings.py).

# ── storage ──────────────────────────────────────────────────────────────────
# Where the Kuzu graph directory lives. Default: ./data/geograph.kuzu beside the
# repo. On Railway, point this at the mounted volume (e.g. /data/geograph.kuzu)
# so the graph survives a redeploy. Kuzu is single-writer: batch ingestion and
# transmission jobs write one at a time; API reads are concurrent.
# KUZU_DB_PATH=

# Postgres for the multi-frequency market panel and the event-study working set.
# On Railway this is the Postgres service's DATABASE_URL. Unset: panel features
# are disabled and the API says so, but the graph and the explorer still run.
# DATABASE_URL=postgresql://user:pass@host:5432/geograph

# ── reasoning (LLM) ──────────────────────────────────────────────────────────
# Used for CAMEO coding of modern non-GDELT text, the reasoning agent, and
# analogy retrieval. NEVER for numbers (build-spec section 17). Unset: the
# deterministic layers — transmission, network analytics, crosswalks — all run.
# OPENAI_API_KEY=

# ── modern-tier ingestion ────────────────────────────────────────────────────
# GDELT via BigQuery (gdelt-bd.gdeltv2.events).
# BIGQUERY_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# FRED for DGS2 / DGS10 Treasury yields.
# FRED_API_KEY=

# The GPR index (Caldara–Iacoviello) spreadsheet URL, used as a regime overlay.
# GPR_INDEX_URL=https://www.matteoiacoviello.com/gpr_files/data_gpr_export.xls

# ── serving ──────────────────────────────────────────────────────────────────
# PORT=8000

# ── boot sequence (containers only — scripts/boot.py) ────────────────────────
# The container seeds the stores BEFORE the API starts, because Kuzu is
# single-writer and the API holds the write lock while it serves. A failed seed
# never stops the boot; /api/health reports it under "boot".
# Set to 0 while a batch job needs the write lock.
# GEOGRAPH_SEED_ON_BOOT=1
# Which packs to seed. Default: every pack that satisfies the contract, so
# packs/china starts seeding itself the day it becomes complete.
# GEOGRAPH_SEED_PACKS=mena
