# GeoGraph configuration. EVERY VALUE HERE IS OPTIONAL — a fresh clone runs
# `python -m core.api.app` with no .env at all. Each unset value disables one
# capability and /api/health.disabled says which; leftover flags show up on
# /api/health.leftover (names only, never secret values).
#
# Railway: keep the KEEP list, delete the DELETE list, do not add the rest.
# The image already sets KUZU_DB_PATH and GEOGRAPH_RAW_DIR; Railway already
# injects PORT. Duplicating those is noise, not configuration.

# ── KEEP on Railway ──────────────────────────────────────────────────────────
# Postgres panel (markets, games, study working set). Reference the Postgres
# service's DATABASE_URL — do not paste a password by hand.
# DATABASE_URL=postgresql://user:pass@host:5432/geograph

# The desk and Head A. NEVER for numbers (build-spec section 17).
# OPENAI_API_KEY=

# Optional: Treasury yields. Unset is honest ("not in the panel yet"), not a zero.
# FRED_API_KEY=

# Optional: GPR overlay URL. Unset: no overlay. Must be an http(s) URL if set.
# GPR_INDEX_URL=https://www.matteoiacoviello.com/gpr_files/data_gpr_export.xls

# ── ALREADY SET BY THE IMAGE / RAILWAY — do not duplicate ────────────────────
# KUZU_DB_PATH=/data/geograph.kuzu
# GEOGRAPH_RAW_DIR=/data/raw
# PORT=8000

# ── DELETE if still present ──────────────────────────────────────────────────
# Unused after the OpenAI switch. Safe to remove; nothing reads it.
# ANTHROPIC_API_KEY=
# Unused. BigQuery transport is unbuilt; the wire loads credential-free.
# GOOGLE_APPLICATION_CREDENTIALS=
# BIGQUERY_PROJECT=
# If this still says claude-*: delete it. Default is gpt-4.1.
# GEOGRAPH_AGENT_MODEL=
# One-shot landmines. Honour-once has already run or will on the next value
# change. Unset so a redeploy cannot re-trigger.
# GEOGRAPH_RESET_GRAPH=
# GEOGRAPH_DROP_AFFECTED=
# GEOGRAPH_REBUILD_AFFECTED=
# Narrows seeding. Default is every complete pack (mena + china + eurasia).
# GEOGRAPH_SEED_PACKS=

# ── SET on production (security at scale) ────────────────────────────────────
# Shared bearer for POST /mcp. Unset = public agent surface (flagged on
# /api/health.alerts). Clients send Authorization: Bearer <token>.
# GEOGRAPH_MCP_TOKEN=
# Shared bearer for /api/storage (volume/table report). Unset = public.
# GEOGRAPH_OPS_TOKEN=
# OpenAPI UI (/docs, /redoc, /openapi.json). Default OFF; set 1 only to debug.
# GEOGRAPH_EXPOSE_DOCS=1
# In-process rate limits on /api and /mcp. Default ON; 0 only for load tests.
# GEOGRAPH_RATE_LIMIT=0

# ── DO NOT SET on a routine (code-ship) deploy ───────────────────────────────
# Defaults are production-safe. Setting these is a measuring/loading deploy
# and costs graph-dark time or worse. The convergence loop does this work
# in the background after the API is up.
# GEOGRAPH_GDELT_ON_BOOT=1
# GEOGRAPH_RESCORE_ON_BOOT=1
# GEOGRAPH_STUDY_ON_BOOT=1
# GEOGRAPH_FORECASTS_ON_BOOT=1
# GEOGRAPH_GAMES_ON_BOOT=1
# GEOGRAPH_BACKTEST_ON_BOOT=1
# GEOGRAPH_READY_IGNORES_GRAPH=1
# GEOGRAPH_JOBS=0
# GEOGRAPH_SEED_ON_BOOT=0
# GEOGRAPH_SNAPSHOT_FROZEN=0
# GEOGRAPH_API_FIRST=0
# GEOGRAPH_STUDY_IN_PROCESS=1
# GEOGRAPH_JOB_STUDY=0   (and GEOGRAPH_JOB_<name>=0 for any other job)

# ── serving ──────────────────────────────────────────────────────────────────
# PORT=8000
